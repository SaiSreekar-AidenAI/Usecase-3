# ─── resolve-490813 (AidenAI) ────────────────────────────────────────────────
# Source of truth for ./deploy.sh --env resolve
#
# DB_PASS is intentionally NOT here — export it in your shell before deploying:
#   export DB_PASS='…'

GCP_ACCOUNT="saisreekar.k@aidenai.com"

PROJECT_ID="resolve-490813"
REGION="us-central1"

# Artifact Registry
REPO_NAME="resolve-repo"

# Cloud Run service names
BACKEND_SERVICE="resolve-backend"
FRONTEND_SERVICE="resolve-frontend"

# Cloud SQL (Postgres)
CLOUD_SQL_INSTANCE_NAME="resolve-db"
DB_USER="resolve_user"
DB_NAME="resolve"

# BigQuery vector store
BQ_DATASET="resolve_vectors"
BQ_TABLE="canned_responses"

# Secret Manager secret holding the Gemini API key
GEMINI_SECRET_NAME="gemini-api-key"
