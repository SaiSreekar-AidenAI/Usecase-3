# ─── gtm-cloud-helpdesk ──────────────────────────────────────────────────────
# Source of truth for ./deploy.sh --env gtm
#
# DB_PASS is intentionally NOT here — export it in your shell before deploying:
#   export DB_PASS='…'

GCP_ACCOUNT="kanapasai@gmail.com"

PROJECT_ID="gtm-cloud-helpdesk"
REGION="us-central1"

# Artifact Registry
REPO_NAME="email-composer-repo"

# Cloud Run service names
BACKEND_SERVICE="email-composer-backend"
FRONTEND_SERVICE="email-composer-frontend"

# Cloud SQL (Postgres)
CLOUD_SQL_INSTANCE_NAME="email-composer-db"
DB_USER="postgres"
DB_NAME="email_composer"

# BigQuery vector store
BQ_DATASET="email_composer_vectors"
BQ_TABLE="canned_responses"

# Secret Manager secret holding the Gemini API key
GEMINI_SECRET_NAME="gemini-api-key"
